    <string name="tarn_shield_dns_desc">Использовать DNS TarnVPN для защиты запросов</string>
    <string name="tarn_shield_autoconnect">Автоподключение</string>
    <string name="tarn_shield_autoconnect_desc">Подключаться к VPN при запуске приложения</string>

    <string name="tarn_dns_provider">DNS-резолвер</string>
    <string name="tarn_dns_title">DNS-резолвер</string>
    <string name="tarn_dns_hint">Имена доменов отправляются по HTTPS выбранному резолверу; соединение с ним идёт по указанному IP без незашифрованного DNS-запроса для запуска.</string>
    <string name="tarn_dns_section">Выбрать резолвер</string>

    <string name="tarn_dns_custom_title">Свой</string>
    <string name="tarn_dns_custom_unset">Не задан</string>
    <string name="tarn_dns_custom_dialog_title">Свой резолвер</string>
    <string name="tarn_dns_custom_dialog_hint">IPv4-адрес DNS-over-HTTPS на 443. Сертификат резолвера должен быть действителен для этого IP.</string>
    <string name="tarn_dns_custom_input_placeholder">203.0.113.5</string>
    <string name="tarn_dns_custom_error">Введите корректный IPv4-адрес</string>

    <string name="tarn_shield_section_network">Сеть</string>
    <string name="tarn_shield_dns_tunnel">DNS через VPN</string>
    <string name="tarn_shield_dns_tunnel_desc">Вкл: DNS идёт через туннель, и тест DNS-leak показывает регион сервера — но под нагрузкой запросы медленнее. Выкл: быстрый прямой DNS (всё равно шифрованный), но тест покажет твой реальный регион</string>
    <string name="tarn_shield_ipv6">IPv6</string>
    <string name="tarn_shield_ipv6_desc">Пускать IPv6-трафик через туннель — без этого приложения с нативным IPv6 могут обойти VPN целиком</string>
    <string name="tarn_shield_fragment">Фрагментация TLS</string>
    <string name="tarn_shield_fragment_desc">Дробить TLS-хендшейк для поддерживаемых TLS-подключений. Не применяется к Reality.</string>

