<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="subscriptions.json" />
        <exclude domain="file" path="subscriptions.json.bak" />
        <exclude domain="file" path="subscriptions.json.new" />
        <exclude domain="file" path="crash_reports" />
        <exclude domain="file" path="oom_reports" />
        <exclude domain="file" path="oom_draft" />
        <exclude domain="external" path="crash_reports" />
        <exclude domain="external" path="oom_reports" />
        <exclude domain="external" path="oom_draft" />
        <!-- Profiles, settings and generated configs can contain VPN credentials. -->
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="configs" />
        <exclude
            domain="file"
            path="configuration.json" />
        <!-- The core's cache file holds the persisted DNS cache (store_dns): the domains
             the device asked about over the last TTL window. Browsing-history metadata,
             not settings — it must never leave the device. -->
        <exclude
            domain="external"
            path="cache.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="subscriptions.json" />
        <exclude domain="file" path="subscriptions.json.bak" />
        <exclude domain="file" path="subscriptions.json.new" />
        <exclude domain="file" path="crash_reports" />
        <exclude domain="file" path="oom_reports" />
        <exclude domain="file" path="oom_draft" />
        <exclude domain="external" path="crash_reports" />
        <exclude domain="external" path="oom_reports" />
        <exclude domain="external" path="oom_draft" />
        <!-- Profiles, settings and generated configs can contain VPN credentials. -->
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="configs" />
        <exclude
            domain="file"
            path="configuration.json" />
        <!-- Same reason as in cloud-backup: the DNS cache is browsing metadata. -->
        <exclude
            domain="external"
            path="cache.db" />
    </device-transfer>
</data-extraction-rules>
