<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Profiles, settings and generated configs can contain VPN credentials. -->
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="configs" />
        <exclude
            domain="file"
            path="configuration.json" />
    </cloud-backup>
    <device-transfer>
        <!-- Profiles, settings and generated configs can contain VPN credentials. -->
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="configs" />
        <exclude
            domain="file"
            path="configuration.json" />
    </device-transfer>
</data-extraction-rules>
