<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="subscriptions.json" />
        <exclude domain="file" path="subscriptions.json.bak" />
        <exclude domain="file" path="subscriptions.json.new" />
        <exclude domain="file" path="crash_reports" />
        <exclude domain="file" path="oom_reports" />
        <exclude domain="file" path="oom_draft" />
        <exclude domain="external" path="crash_reports" />
        <exclude domain="external" path="oom_reports" />
        <exclude domain="external" path="oom_draft" />
        <!-- Profiles, settings and generated configs can contain VPN credentials. -->
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="configs" />
        <exclude
            domain="file"
            path="configuration.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="subscriptions.json" />
        <exclude domain="file" path="subscriptions.json.bak" />
        <exclude domain="file" path="subscriptions.json.new" />
        <exclude domain="file" path="crash_reports" />
        <exclude domain="file" path="oom_reports" />
        <exclude domain="file" path="oom_draft" />
        <exclude domain="external" path="crash_reports" />
        <exclude domain="external" path="oom_reports" />
        <exclude domain="external" path="oom_draft" />
        <!-- Profiles, settings and generated configs can contain VPN credentials. -->
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="configs" />
        <exclude
            domain="file"
            path="configuration.json" />
    </device-transfer>
</data-extraction-rules>
