<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="file" path="subscriptions.json" />
    <exclude domain="file" path="subscriptions.json.bak" />
    <exclude domain="file" path="subscriptions.json.new" />
    <exclude domain="file" path="crash_reports" />
    <exclude domain="file" path="oom_reports" />
    <exclude domain="file" path="oom_draft" />
    <exclude domain="external" path="crash_reports" />
    <exclude domain="external" path="oom_reports" />
    <exclude domain="external" path="oom_draft" />

    <!-- Profiles, settings and generated configs can contain VPN credentials. -->
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="file"
        path="configs" />
    <exclude
        domain="file"
        path="configuration.json" />

    <!-- The core's cache file lives in the external working dir and holds the persisted
         DNS cache (experimental.cache_file.store_dns): the domains the device asked about
         over the last TTL window. That is browsing-history metadata, not settings —
         it must never leave the device with a cloud backup or a device transfer. -->
    <exclude
        domain="external"
        path="cache.db" />

</full-backup-content>
