    <string name="tarn_dns_hint">Domain names are sent over HTTPS to the selected resolver through its literal IP, without a plaintext DNS bootstrap lookup.</string>
    <string name="tarn_dns_section">Choose a resolver</string>

    <string name="tarn_dns_custom_title">Custom</string>
    <string name="tarn_dns_custom_unset">Not set</string>
    <string name="tarn_dns_custom_dialog_title">Custom resolver</string>
