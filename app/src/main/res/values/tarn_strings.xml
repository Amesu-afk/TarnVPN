    <string name="tarn_connection_lab_entry_desc">Tune routing and full-test parameters</string>
    <string name="tarn_connection_lab_title">Connection lab</string>
    <string name="tarn_connection_lab_intro">Change one parameter at a time and compare results on the same network. Automatic values are the safest defaults.</string>
