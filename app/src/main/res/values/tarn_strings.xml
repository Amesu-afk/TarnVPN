    <string name="tarn_shield_section_network">Network</string>
    <string name="tarn_shield_dns_tunnel">DNS through VPN</string>
    <string name="tarn_shield_dns_tunnel_desc">On: DNS goes through the tunnel, so a DNS-leak test shows the exit region — but lookups are slower under load. Off: fast direct DNS (still encrypted), but the test shows your real region</string>
    <string name="tarn_shield_ipv6">IPv6</string>
    <string name="tarn_shield_ipv6_desc">Route IPv6 traffic through the tunnel too — otherwise apps with native IPv6 can bypass the VPN entirely</string>
    <string name="tarn_shield_fragment">TLS fragmentation</string>
    <string name="tarn_shield_fragment_desc">Split the TLS handshake for supported TLS connections. It does not apply to Reality.</string>

