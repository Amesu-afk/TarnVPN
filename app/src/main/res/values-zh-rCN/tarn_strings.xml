    <string name="tarn_shield_section_network">网络</string>
    <string name="tarn_shield_ru_direct">俄罗斯网站绕过 VPN</string>
    <string name="tarn_shield_ru_direct_desc">银行、政务服务、商城和 .ru 网站将直接访问并在本地解析；使用境外地址时可能拒绝服务或变慢。关闭此项可让所有流量通过出口服务器。</string>
    <string name="tarn_shield_direct_domains">我的直连网站</string>
    <string name="tarn_shield_direct_domains_empty">未添加</string>
    <plurals name="tarn_shield_direct_domains_count">
        <item quantity="other">%1$d 个域名</item>
    </plurals>
    <string name="tarn_direct_domains_title">直连网站</string>
    <string name="tarn_direct_domains_hint">这些网站会与内置列表一起绕过 VPN，并在关闭该列表时继续生效。一个域名覆盖其所有子域名：添加 example.com 也会覆盖 pay.example.com。</string>
    <string name="tarn_direct_domains_empty">尚未添加内容。添加一个拒绝通过 VPN 工作的网站，例如银行、工作门户或本地服务。</string>
    <string name="tarn_direct_domains_add">添加域名</string>
    <string name="tarn_direct_domains_add_hint">输入域名或复制的链接；应用会从中提取地址。</string>
    <string name="tarn_direct_domains_add_action">添加</string>
    <string name="tarn_direct_domains_placeholder">example.com</string>
    <string name="tarn_direct_domains_invalid">其中没有域名。请输入类似 example.com 的内容。</string>
    <string name="tarn_direct_domains_remove">移除</string>
    <string name="tarn_shield_dns_tunnel">DNS 通过 VPN</string>
    <string name="tarn_shield_dns_tunnel_desc">开启：DNS 经由隧道，DNS 泄漏测试会显示出口地区，但高负载下解析更慢。关闭：快速直连 DNS（仍加密），但测试会显示你的真实地区。</string>
    <string name="tarn_shield_ipv6">IPv6</string>
    <string name="tarn_shield_ipv6_desc">也让 IPv6 流量通过隧道；否则具有原生 IPv6 的应用可能完全绕过 VPN。</string>
    <string name="tarn_shield_fragment">TLS 分片</string>
    <string name="tarn_shield_fragment_desc">将 TLS 握手拆分到多个数据包，使依赖其形状的过滤更难匹配。也适用于 Reality。当服务器在 Wi‑Fi 可连接但在移动网络不可连接时可尝试。</string>

