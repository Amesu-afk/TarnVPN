    <string name="tarn_dns_title">حل‌کننده DNS</string>
    <string name="tarn_dns_hint">نام‌های دامنه از طریق HTTPS و IP صریح حل‌کننده انتخاب‌شده ارسال می‌شوند و برای راه‌اندازی، جست‌وجوی DNS بدون رمز ندارند.</string>
