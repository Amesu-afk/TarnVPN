    <string name="tarn_shield_section_network">شبکه</string>
    <string name="tarn_shield_ru_direct">سایت‌های روسی VPN را دور می‌زنند</string>
    <string name="tarn_shield_ru_direct_desc">بانک‌ها، خدمات دولتی، بازارها و سایت‌های .ru مستقیم باز می‌شوند و از اینجا حل نام می‌شوند؛ با نشانی خارجی کند می‌شوند یا پاسخ نمی‌دهند. برای فرستادن همه‌چیز از خروجی VPN، آن را خاموش کنید.</string>
    <string name="tarn_shield_direct_domains">سایت‌های مستقیم من</string>
    <string name="tarn_shield_direct_domains_empty">چیزی اضافه نشده</string>
    <plurals name="tarn_shield_direct_domains_count">
